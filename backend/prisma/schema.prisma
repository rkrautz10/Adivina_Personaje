generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  IN_PROGRESS
  FINISHED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum RoundStatus {
  ACTIVE
  RESOLVED
  EXPIRED
}

model Player {
  id              String   @id @default(cuid())
  alias           String   @db.VarChar(30)
  normalizedAlias String   @unique @db.VarChar(30)
  createdAt       DateTime @default(now())
  matches         Match[]
}

model Match {
  id              String          @id @default(cuid())
  playerId        String
  status          MatchStatus     @default(IN_PROGRESS)
  difficultyLevel DifficultyLevel @default(EASY)
  currentStreak   Int             @default(0)
  totalScore      Int             @default(0)
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  player          Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rounds          Round[]

  @@index([playerId])
  @@index([status, finishedAt])
}

model Round {
  id         String      @id @default(cuid())
  matchId    String
  roundNumber Int
  entityId   Int
  entityName String      @db.VarChar(100)
  status     RoundStatus @default(ACTIVE)
  hintsUsed  Int         @default(0)
  hints      Json?
  correct    Boolean?
  score      Int         @default(0)
  startedAt  DateTime    @default(now())
  resolvedAt DateTime?
  match      Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  entity     EntityCache @relation(fields: [entityId], references: [entityId])

  @@unique([matchId, roundNumber])
  @@index([matchId])
}

model EntityCache {
  entityId   Int      @id
  name       String   @db.VarChar(100)
  imageUrl   String
  attributes Json
  cachedAt   DateTime @default(now())
  expiresAt  DateTime?
  rounds     Round[]

  @@index([expiresAt])
}